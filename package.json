{
  "name": "markdown-live-preview",
  "version": "1.0.0",
  "description": "A private, offline Markdown editor with live preview and local autosaves.",
  "main": "index.js",
  "scripts": {
    "test": "npm run build:pages && playwright test",
    "update:css-version": "node scripts/update-css-version.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/markdown-live-preview/",
    "preview": "vite preview",
    "preview:pages": "vite preview --base=/markdown-live-preview/",
    "serve-dist": "http-server dist -p 5001 -c-1",
    "build-and-serve": "npm run build && npm run serve-dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheoGibbons/markdown-live-preview.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TheoGibbons/markdown-live-preview/issues"
  },
  "homepage": "https://theogibbons.github.io/markdown-live-preview/",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "http-server": "^14.1.1",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "github-markdown-css": "^5.8.1",
    "marked": "^15.0.7",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.52.2",
    "storehouse-js": "github:tanabe/Storehouse-js"
  }
}
